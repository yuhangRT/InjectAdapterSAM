{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      // --- Git: 只放行只读/安全子集 ---
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git remote -v)",
      "Bash(git grep *)",

      // --- 文件查看/检索：只读 ---
      "Bash(ls *)",
      "Bash(find . *)",
      "Bash(tree *)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(sed -n *)",
      "Bash(awk *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",

      // --- 构建/测试/格式化：限制在项目目录 ---
      "Bash(make *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm run lint*)",
      "Bash(npm run format*)",
      "Bash(pnpm run *)",
      "Bash(yarn run *)",
      "Bash(bun run *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(python -m unittest *)",
      "Bash(python -m compileall *)",
      "Bash(ruff *)",
      "Bash(black *)",
      "Bash(isort *)",
      "Bash(pre-commit run *)",

      // --- 依赖/环境：相对安全，但仍建议项目里用 ---
      "Bash(node -v)",
      "Bash(npm -v)",
      "Bash(python --version)",
      "Bash(pip --version)",
      "Bash(pip list)",
      "Bash(uv *)",
      "Bash(poetry *)",
      "Bash(venv *)"
    ],

    "deny": [
      // --- 你说的“删除之外”：这里把删除类统一挡住 ---
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(del *)",

      // --- 覆盖/破坏性写入 ---
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(dd *)",
      "Bash(truncate *)",
      "Bash(>*)",
      "Bash(>>*)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(chattr *)",

      // --- 提权/系统级 ---
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(systemctl *)",
      "Bash(service *)",

      // --- 网络外联/下载/远程执行（高风险）---
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(netcat *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git clone *)",
      "Bash(git submodule update *)",

      // --- 容器/集群/云：通常属于“真的会动生产”的危险区 ---
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(kubectl *)",
      "Bash(helm *)",
      "Bash(terraform *)",
      "Bash(aws *)",
      "Bash(gcloud *)",
      "Bash(az *)",

      // --- 常见“管道到 shell”远程执行套路 ---
      "Bash(* | sh *)",
      "Bash(* | bash *)",
      "Bash(* | zsh *)"
    ]
  }
}